---
const education = [
  {
    degree: "Bachelor of Science",
    institution: "Avanthi Degree and PG College",
    duration: "2020 - 2023",
    description: "Specialization: Mathematics, Statistics, Computer Science. Multidisciplinary program building strong analytical and programming foundations."
  },
];
---
<section id="education" class="w-full max-w-screen-2xl px-4 py-12 flex flex-col gap-6 items-center">
  <h2 class="z-10 w-full max-w-xl sm:text-center text-2xl sm:text-3xl md:text-4xl font-medium tracking-tighter text-pretty bg-clip-text text-transparent bg-gradient-to-b from-background via-background to-muted-foreground">Education</h2>
  <div class="w-full max-w-2xl flex flex-col gap-6">
    {education.map((edu) => (
      <div class="bg-card rounded-lg p-6 shadow flex flex-col gap-2 border border-border transition-transform duration-300 ease-in-out hover:-translate-y-4 hover:shadow-2xl">
        <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-2">
          <span class="font-semibold text-lg bg-clip-text text-transparent bg-gradient-to-br from-primary via-foreground to-foreground">{edu.degree}</span>
          <span class="text-sm text-muted-foreground">{edu.institution} | {edu.duration}</span>
        </div>
        <p class="text-sm md:text-base text-foreground">{edu.description}</p>
      </div>
    ))}
  </div>
</section> 