---
import { HoverEffect } from "@/components/ui/HoverEffect";

const projects = [
  {
    title: "FMCG Warehouse Risk Intelligence & Supply Chain Analytics",
    description: "GraphRAG-powered AI system that converts 25,000+ FMCG warehouse records into a knowledge graph for real-time, multi-hop risk intelligence, achieving 94.2% accuracy and ₹2.4 crore potential cost savings.",
    link: "https://github.com/dhanushmekala04/Graph-Based-AI-for-Supply-Chain-Intelligence",
    points: [],
    tech: [
       
        { name: "meta", svg: "/logos/meta-color (2).svg" },
        { name: "Neo4j", svg: "/logos/New4j.svg" },
        { name: "FastAPI", svg: "/logos/FastAPI.svg" },
        { name: "Pandas", svg: "/logos/Pandas.svg" },
    ]
  },
  {
    title: "MultiStore Demand Forecasting System",
    description: "Deep learning–based multi-store demand forecasting system using CNN-LSTM to predict 500+ SKU demand with 16.49% MAPE, reducing stockouts by 40% and wastage by 30%.",
    link: "https://github.com/dhanushmekala04/Multi-Store-Demand-Forecasting-System",
    
    tech: [
        { name: "TensorFlow", svg: "/logos/TensorFlow.svg" },
        { name: "Keras", svg: "/logos/Keras.svg" },
        { name: "Pandas", svg: "/logos/Pandas.svg" },
        { name: "Plotly", svg: "/logos/Ploty.svg" }
    ]
  },
  {
    title: "Domain-FineTuned LLM for Supply Chain Graph Queries",
    description: "Domain-specific Phi-3 LLM fine-tuned with QLoRA to translate natural-language supply chain questions into executable Neo4j Cypher queries. Trained on 10,000+ graph-structured examples and released as a GGUF-quantized model for efficient deployment.",
    link: "https://github.com/dhanushmekala04/Supply-Chain-Domain-LLM---Phi-3-Fine-tuned-Model",
  
    tech: [
        { name: "Huggingface", svg: "/logos/huggingface.svg" },
        { name: "microsoft", svg: "/logos/microsoft.svg" },
        { name: "ollama", svg: "/logos/ollama.svg" },
        { name: "python", svg: "/logos/Python.svg" }
    ]
  },
  {
    title: "Agentic Customer Support Automation System",
    description: "Production-style multi-agent system using LangGraph with 6 specialized agents for automated ticket triage and resolution, achieving 91% automated response accuracy with human-in-the-loop escalation and seconds-level resolution time.",
    link: "https://github.com/dhanushmekala04/Customer-Support-Ticket-Management",
    tech: [
        { name: "LangChain", svg: "logos/langgraph.svg" },
        { name: "FastAPI", svg: "/logos/FastAPI.svg" },
        { name: "Docker", svg: "logos/openai-wordmark.svg" },
        { name: "python", svg: "/logos/Python.svg" }
    ]
  },
];

import Image from "astro/components/Image.astro";
---

<section
  id="projects"
  class="relative overflow-hidden w-full max-w-screen-2xl text-center flex flex-col justify-center items-center gap-10 px-4 py-24 sm:py-24 select-none"
>
  <h1  class="z-10 w-full max-w-xl sm:text-center text-2xl sm:text-3xl md:text-4xl font-medium tracking-tighter text-pretty bg-clip-text text-transparent bg-gradient-to-b from-background via-background to-muted-foreground"
  >
    My AI/ML Projects
  </h1>
  <p
    class="w-full max-w-xl sm:text-center text-normal sm:text-lg md:text-xl font-light tracking-tighter text-balance text-muted-foreground"
  >
    A selection of projects showcasing my skills in machine learning and artificial intelligence.
  </p>
  <div class="max-w-5xl mx-auto px-8 stagger-children">
    <HoverEffect items={projects} client:load />
  </div>
  <div
    class="bg-white opacity-10 absolute size-80 top-[-160px] border blur-[150px] rounded-full"
  >
  </div>
</section>

<style>
  .animate-vertical-scroll {
    animation: vertical-scroll 8s linear infinite alternate;
  }
  @keyframes vertical-scroll {
    0% { transform: translateY(0); }
    100% { transform: translateY(-60%); }
  }
</style>
