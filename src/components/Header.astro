 * https://www.radix-ui.com/icons
 */
---

<header class="w-full px-4 py-6 flex justify-between items-center relative">
  <!-- Centered Welcome Message -->
  <div class="absolute left-1/2 transform -translate-x-1/2">
    <h1 class="text-xl md:text-2xl font-medium tracking-tighter text-pretty bg-clip-text text-transparent bg-gradient-to-b from-background via-background to-muted-foreground text-center">
      Step in and take a look around ...
    </h1>
  </div>

  <!-- Section Navigation -->
  <div class="flex gap-4 ml-auto">
    <a href="#experience" class="text-xs font-medium tracking-tighter text-muted-foreground hover:text-primary transition-colors duration-300 cursor-pointer">
      Experience
    </a>

    <a href="#projects" class="text-xs font-medium tracking-tighter text-muted-foreground hover:text-primary transition-colors duration-300 cursor-pointer">
      Projects
    </a>

    <a href="#education" class="text-xs font-medium tracking-tighter text-muted-foreground hover:text-primary transition-colors duration-300 cursor-pointer">
      Education
    </a>

    <a href="#certifications" class="text-xs font-medium tracking-tighter text-muted-foreground hover:text-primary transition-colors duration-300 cursor-pointer">
      Certifications
    </a>

    <a href="#about" class="text-xs font-medium tracking-tighter text-muted-foreground hover:text-primary transition-colors duration-300 cursor-pointer">
      About me
    </a>
  </div>
</header>
