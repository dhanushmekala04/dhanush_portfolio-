---
import { FlipWords } from "@/components/ui/FlipWords";
---

<section
  class="w-full flex flex-col gap-50 justify-center items-center px-8 py-36 relative"
>
  <img
    src="/assets/hero_background.jpg"
    alt="Hero Background"
    class="absolute inset-0 w-full h-full object-cover z-0 opacity-10 parallax"
  />
  <div class="flex flex-col gap-2 relative z-10 stagger-children">
    <b>
    <h2
      class="z-10 w-full max-w-xl sm:text-center text-xl sm:text-2xl md:text-3xl font-medium tracking-tighter text-pretty bg-clip-text text-transparent bg-gradient-to-b from-background via-background to-muted-foreground"
    >
      Hi, I'm  DHANUSH VARDHAN....
    </h2>
    </b>
    <h1
      class="z-10 w-full max-w-xl sm:text-center text-3xl sm:text-5xl md:text-7xl font-medium tracking-tighter text-pretty text-white"
    >
      <FlipWords words={[" AI/ML Engineer ", " Data Scientist",]} className="text-white" client:load />
    </h1>
    <span class="w-full max-w-xl text-muted-foreground sm:text-center text-xl sm:text-lg md:text-xl font-normal tracking-tighter text-balance"
          style="animation-delay: 0.6s; animation-fill-mode: forwards;">
          Building intelligent systems that actually ship.


    </span>
      <div class="flex flex-col gap-3">
        <h2
        class="w-full max-w-xl text-muted-foreground sm:text-center text-normal sm:text-lg md:text-xl font-light tracking-tighter text-balance"
      >
      I build production-grade AI systems — from machine learning and deep learning models to LLM pipelines, Generative AI applications, and multi-agent workflows that operate at real-world scale. <b><strong>Actively seeking AI/ML Engineer, LLM Engineer, and Data Scientist roles.</strong></b>
      </h2>
  <br>
  </div>
  <div class="w-full flex flex-col gap-6 items-center justify-center">
    <!-- Download Resume Button -->
    <div class="flex flex-wrap gap-9 items-center justify-center">
      <a
        href="/assets/dhanush-resume.pdf" download
        target="_blank"
        rel="noopener noreferrer"
        class="relative w-fit flex justify-center items-center px-6 py-4 sm:px-6 sm:py-3 sm:text-lg font-medium text-black bg-white rounded-full perfect-shadow transition-all duration-300 ease-in-out hover:scale-105 hover:shadow-2xl animate-bounce-gentle"
      >
         @ Download Resume
        <div
          class="z-[-1] bg-gradient-to-b from-secondary via-white to-white absolute w-[calc(100%-4px)] h-[calc(100%-4px)] rounded-full border-t-2 border-secondary"
        >
        </div>
      </a>
    </div>

    <!-- Social Media Links -->
    <div class="flex gap-6 items-center justify-center">
      <a
        href="https://www.linkedin.com/in/dhanushmekala04/"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-3 bg-white/10 backdrop-blur-sm rounded-full border border-white/20 hover:border-white/40 hover:bg-white/20 transition-all duration-300 hover:scale-110"
        aria-label="LinkedIn Profile"
      >
        <img
          src="/logos/LinkedIn.svg"
          alt="LinkedIn"
          class="w-6 h-6 group-hover:brightness-110 transition-all duration-300"
        />
      </a>

      <a
        href="https://github.com/dhanushmekala04"
        target="_blank"
        rel="noopener noreferrer"
        class="group p-3 bg-white/10 backdrop-blur-sm rounded-full border border-white/20 hover:border-white/40 hover:bg-white/20 transition-all duration-300 hover:scale-110"
        aria-label="GitHub Profile"
      >
        <img
          src="/logos/GitHub.svg"
          alt="GitHub"
          class="w-6 h-6 group-hover:brightness-110 transition-all duration-300"
        />
      </a>
    </div>
  </div>
  </br>
</section>

<style>
  /* FlipWords fallback handling */
  .flip-words-fallback {
    display: block;
  }

  /* Hide fallback when FlipWords loads */
  astro-island:has(.flip-words-container) ~ .flip-words-fallback {
    display: none;
  }

  /* Ensure FlipWords container is visible */
  .flip-words-container {
    opacity: 1 !important;
  }
</style>

<style>
  @keyframes heroIn {
    0% {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    60% {
      opacity: 1;
      transform: translateY(-0.05rem);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  h1 {
    opacity: 0;
    animation: heroIn 0.7s cubic-bezier(0.5, 1.15, 0.2, 1.1) forwards;
  }
  p {
    opacity: 0;
    animation: heroIn 0.7s cubic-bezier(0.5, 1.15, 0.2, 1.1) 0.3s forwards;
  }
  a {
    opacity: 0;
    animation: heroIn 0.7s cubic-bezier(0.5, 1.15, 0.2, 1.1) 0.6s forwards;
  }
</style> 