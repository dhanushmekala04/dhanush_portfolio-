---
import Image from "astro/components/Image.astro";

/* 
    Logos for AI/ML stack (use placeholder or relevant SVGs in /logos/ directory)
*/
const logos = [
  { src: "/logos/Python.svg", alt: "Python Logo" },
  { src: "/logos/TensorFlow.svg", alt: "TensorFlow Logo" },
  { src: "/logos/PyTorch.png", alt: "PyTorch Logo" },
  { src: "/logos/Keras.svg", alt: "Keras Logo" },
  { src: "/logos/scikit-learn (1).png", alt: "Scikit-learn Logo" },
  { src: "/logos/NumPy.png", alt: "NumPy Logo" },
  { src: "/logos/Pandas.svg", alt: "Pandas Logo" },
  { src: "/logos/Matplotlib.png", alt: "matplotlib Logo" },
  { src: "/logos/PostgresSQL.png", alt: "PostgresSQL Logo" },
  { src: "/logos/huggingface.svg", alt: "huggingface Logo" },
  { src: "/logos/FastAPI.svg", alt: "FastAPI Logo" },
  { src: "/logos/langgraph.svg", alt: "langgraph Logo" },
  { src: "/logos/AWS.svg", alt: "aws Logo" },
  {src: "/logos/openai-wordmark.svg", alt: "openai Logo" },
];
---

<section
  class="relative w-full text-center flex flex-col justify-center items-center gap-5 px-4 py-20 sm:py-24 pointer-events-none"
>
  <h2
    class="z-10 w-full max-w-xl sm:text-center text-2xl sm:text-3xl md:text-4xl font-medium tracking-tighter text-pretty bg-clip-text text-transparent bg-gradient-to-b from-background via-background to-muted-foreground"
  >
  Tech Stack I Work With

  </h2>
  <p
    class="w-full max-w-xl text-muted-foreground sm:text-center text-normal sm:text-lg md:text-xl font-light tracking-tighter text-balance"
  >
  Modern technologies used across my AI and ML projects.


  </p>
  <div
    class="w-full h-fit max-w-xl flex flex-col justify-center select-none overflow-hidden gradient hover-lift"
  >
    <div class="w-max flex flex-nowrap gap-[4rem] animate-slide-logos">
      {
        logos.concat(logos).map((logo) => (
          <div class="aspect-square flex items-center justify-center size-20">
            <Image
              src={logo.src}
              alt={logo.alt}
              width={64}
              height={64}
              loading="eager"
              class="object-contain"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gradient {
    mask: linear-gradient(
      90deg,
      transparent,
      black 20%,
      black 80%,
      transparent
    );
    webkitmask: linear-gradient(
      90deg,
      transparent,
      black 20%,
      black 80%,
      black transparent
    );
  }
</style>
